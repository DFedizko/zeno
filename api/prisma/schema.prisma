generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts    Account[]
  subscription Subscription?
  connections  Connection[]
}

model Account {
  id                String @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  provider               String
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(Active)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  Active
  Inactive
  Cancelled
}

// ─── Finance Module ──────────────────────────────────────────

model Connection {
  id                String           @id @default(uuid())
  userId            String
  provider          String
  providerItemId    String           @unique
  connectorName     String
  connectorImageUrl String?
  connectorColor    String?
  status            ConnectionStatus @default(UPDATING)
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccounts FinancialAccount[]

  @@index([userId])
}

enum ConnectionStatus {
  UPDATING
  UPDATED
  ERROR
  WAITING_USER_INPUT
}

model FinancialAccount {
  id                   String         @id @default(uuid())
  connectionId         String
  providerAccountId    String         @unique
  type                 AccountType
  subtype              AccountSubtype
  name                 String
  number               String?
  balance              Decimal        @db.Decimal(12, 2)
  currencyCode         String         @default("BRL")
  creditLimit          Decimal?       @db.Decimal(12, 2)
  availableCreditLimit Decimal?       @db.Decimal(12, 2)
  cardBrand            String?
  cardLevel            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  connection   Connection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        CreditCardBill[]

  @@index([connectionId])
}

enum AccountType {
  BANK
  CREDIT
}

enum AccountSubtype {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

model Transaction {
  id                    String            @id @default(uuid())
  financialAccountId    String
  providerTransactionId String            @unique
  date                  DateTime
  description           String
  amount                Decimal           @db.Decimal(12, 2)
  type                  TransactionType
  status                TransactionStatus
  operationType         String?
  categoryId            String?
  currencyCode          String            @default("BRL")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  category         Category?        @relation(fields: [categoryId], references: [id])

  @@index([financialAccountId])
  @@index([date])
  @@index([categoryId])
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  POSTED
}

model Category {
  id    String  @id @default(uuid())
  name  String  @unique
  icon  String?
  color String?

  transactions Transaction[]
}

model CreditCardBill {
  id                 String     @id @default(uuid())
  financialAccountId String
  providerBillId     String?    @unique
  dueDate            DateTime
  closeDate          DateTime
  totalAmount        Decimal    @db.Decimal(12, 2)
  minimumPayment     Decimal?   @db.Decimal(12, 2)
  status             BillStatus @default(OPEN)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
}

enum BillStatus {
  OPEN
  CLOSED
  PAID
}
